generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MASTER_SELLER
  NORMAL_SELLER
  CUSTOMER
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum SubscriptionPlan {
  FREE
  BASIC
  PREMIUM
}

enum OperatorApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  APPROVED
  REJECTED
}

enum OperatorDocumentStatus {
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum LicenceVerificationStatus {
  UNDER_REVIEW
  APPROVED
  REJECTED
  REUPLOAD_REQUIRED
}

enum OperatorUserStatus {
  ACTIVE
  SUSPENDED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  ALTERNATIVE_SUGGESTED
  PENDING_PAYMENT
  CONFIRMED
  PAID
  READY_FOR_PICKUP
  IN_PROGRESS
  OVERDUE
  EXPIRED
  CANCELLED
  COMPLETED
  NO_SHOW
  NO_SHOW_UNPAID
}

enum ListingCategory {
  CAR_RENTAL
  TOUR
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
  WITHDRAWN
}

enum TransmissionType {
  AUTOMATIC
  MANUAL
}

enum VehicleType {
  SEDAN
  HATCHBACK
  COMPACT
  SUV
  MPV
  PICKUP
  VAN
}

enum Powertrain {
  PETROL
  DIESEL
  HYBRID
  EV
}

enum Drivetrain {
  TWO_WD
  FOUR_WD
  AWD
}

enum FuelPolicy {
  FULL_TO_FULL
  SAME_TO_SAME
}

enum MileagePolicy {
  UNLIMITED
  LIMITED
}

enum PointUsage {
  PICKUP
  DROPOFF
  BOTH
}

enum AddonUnit {
  PER_DAY
  PER_BOOKING
}

enum BookingChannel {
  WEB
  HOST_EMBED
  MOBILE
  WHATSAPP
}

enum PaymentStatus {
  UNPAID
  PENDING_VERIFICATION
  DOWN_PAYMENT_PENDING_VERIFICATION
  PARTIALLY_PAID
  FINAL_PAYMENT_PENDING_VERIFICATION
  PAID
  FAILED
  OVERDUE
}

enum RefundStatus {
  PENDING
  PROCESSING
  REFUNDED
  FAILED
}

enum PaymentMethod {
  PENDING
  PAYPAL
  STRIPE
  DUITNOW
  SPAY
  BANK_TRANSFER
  CASH
}

enum PaymentScheduleEntryType {
  PAYMENT
  LICENCE
}

enum PaymentScheduleEntryStatus {
  DUE
  PAID
  EXPIRED
  VOID
}

enum DiscountFundingSource {
  OPERATOR
  PLATFORM
}

enum OperatorPayoutStatus {
  PENDING
  TRANSFERRED
  CANCELLED
}

enum ReceiptStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  GENERATED
  SENT
  PAID
  CANCELLED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum OperatorAccessLevel {
  OWNER
  STAFF
}

model User {
  id       Int      @id @default(autoincrement())
  userCode String   @unique
  name     String
  email    String   @unique
  password String
  role     UserRole @default(CUSTOMER)

  phone           String?
  profileImageUrl String? @db.Text

  notifyBookingUpdates   Boolean @default(true)
  notifyPaymentReminders Boolean @default(true)
  notifyInvoices         Boolean @default(true)
  notifyPromotions       Boolean @default(false)

  operatorAccessLevel OperatorAccessLevel?
  operatorUserStatus  OperatorUserStatus   @default(ACTIVE)

  provisionedVia String? // "HOST" for auto-provisioned customers
  customerStatus String    @default("ACTIVE") // "RESTRICTED" until OTP step-up
  otpCodeHash    String?
  otpExpiresAt   DateTime?
  otpAttempts    Int       @default(0)

  operatorId Int?
  operator   Operator? @relation(fields: [operatorId], references: [id])

  bookings                 Booking[]
  notifications            Notification[]
  auditLogs                AuditLog[]
  refreshTokens            RefreshToken[]
  passwordSetupTokens      PasswordSetupToken[]
  applicationReviews       OperatorApplicationReview[] @relation("ApplicationReviewer")
  documentReviews          OperatorDocument[]          @relation("DocumentReviewer")
  reviewedApplications     OperatorApplication[]       @relation("ApplicationReviewerUser")
  licenceDocuments         CustomerLicenceDocument[]
  reviewedLicenceDocuments CustomerLicenceDocument[]   @relation("LicenceReviewer")
  creditProfile            CustomerCreditProfile?
  creditEventActor         CreditProfileEvent[]        @relation("CreditEventActor")
  creditAppeals            CreditAppeal[]              @relation("CreditAppealCustomer")
  reviewedCreditAppeals    CreditAppeal[]              @relation("CreditAppealReviewer")
  bookingStatusChanges     BookingStatusHistory[]      @relation("BookingStatusActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userCode])
  @@index([operatorId])
  @@index([role])
  @@index([operatorUserStatus])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model CustomerCreditProfile {
  id                       Int      @id @default(autoincrement())
  customerId               Int      @unique
  customer                 User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  successfulOnTimePayments Int      @default(0)
  expiredBookings          Int      @default(0)
  tier                     String   @default("Normal")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  events CreditProfileEvent[]
}

model CreditProfileEvent {
  id           Int                   @id @default(autoincrement())
  customerId   Int
  customer     CustomerCreditProfile @relation(fields: [customerId], references: [customerId], onDelete: Cascade)
  actorUserId  Int?
  actor        User?                 @relation("CreditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  eventKey     String
  eventType    String
  reason       String                @default("Credit profile event")
  beforeTier   String?
  afterTier    String?
  reversalOfId Int?
  reversalOf   CreditProfileEvent?   @relation("CreditEventReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals    CreditProfileEvent[]  @relation("CreditEventReversal")
  appeals      CreditAppeal[]
  createdAt    DateTime              @default(now())

  @@unique([customerId, eventKey])
  @@index([customerId, eventType])
}

model CreditAppeal {
  id         Int                @id @default(autoincrement())
  customerId Int
  customer   User               @relation("CreditAppealCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  eventId    Int
  event      CreditProfileEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  reason     String
  status     String             @default("PENDING")
  resolution String?
  upheldById Int?
  upheldBy   User?              @relation("CreditAppealReviewer", fields: [upheldById], references: [id], onDelete: SetNull)
  resolvedAt DateTime?
  createdAt  DateTime           @default(now())

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model PasswordSetupToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Operator {
  id           Int           @id @default(autoincrement())
  operatorCode String        @unique
  companyName  String
  email        String        @unique
  phone        String?
  logoUrl      String?
  status       CompanyStatus @default(ACTIVE)

  subscriptionPlan SubscriptionPlan @default(FREE)

  // Seller page (FR-CUST-007). The slug gives the operator a short link to
  // share (/o/<slug>); the rest is written by the operator.
  slug                   String?  @unique
  about                  String?  @db.Text
  coverImageUrl          String?
  establishedYear        Int?
  languages              String[] @default([])
  stripeAccountId        String?
  stripeOnboardingStatus String   @default("NOT_STARTED")
  stripeRequirements     Json?

  // ── Phase 1: per-operator host integration ──────────────────────────
  apiKeyHash      String?   @unique // sha-256 of the active host API key
  apiKeyPrefix    String? // masked label for dashboard display
  apiKeyRotatedAt DateTime? // when the active key was last issued
  allowedOrigins  String[]  @default([]) // embed frame-ancestors + postMessage allowlist

  users        User[]
  bookings     Booking[]
  configs      BNPLConfig[]
  featureFlags FeatureFlag[]

  branches Branch[]
  listings Listing[]

  applications OperatorApplication[]
  documents    OperatorDocument[]
  payouts      OperatorPayout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorCode])
  @@index([status])
}

model OperatorApplication {
  id                         Int                       @id @default(autoincrement())
  operatorId                 Int                       @unique
  operator                   Operator                  @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  status                     OperatorApplicationStatus @default(SUBMITTED)
  businessRegistrationNumber String
  businessAddress            String                    @db.Text
  submittedAt                DateTime                  @default(now())
  reviewedAt                 DateTime?
  reviewedById               Int?
  reviewedBy                 User?                     @relation("ApplicationReviewerUser", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectionReason            String?                   @db.Text
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  documents OperatorDocument[]
  reviews   OperatorApplicationReview[]

  @@index([status])
  @@index([reviewedById])
}

model OperatorDocument {
  id              Int                    @id @default(autoincrement())
  operatorId      Int
  operator        Operator               @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  applicationId   Int
  application     OperatorApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentType    String
  originalName    String
  storageKey      String                 @unique
  content         Bytes                  @db.ByteA
  mimeType        String
  sizeBytes       Int
  status          OperatorDocumentStatus @default(UNDER_REVIEW)
  expiresAt       DateTime?
  rejectionReason String?                @db.Text
  reviewedAt      DateTime?
  reviewedById    Int?
  reviewedBy      User?                  @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([operatorId])
  @@index([applicationId])
  @@index([status])
  @@index([expiresAt])
}

model OperatorApplicationReview {
  id            Int                       @id @default(autoincrement())
  applicationId Int
  application   OperatorApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewerId    Int
  reviewer      User                      @relation("ApplicationReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  decision      OperatorApplicationStatus
  reason        String                    @db.Text
  createdAt     DateTime                  @default(now())

  @@index([applicationId])
  @@index([reviewerId])
}

model CustomerLicenceDocument {
  id              Int                       @id @default(autoincrement())
  customerId      Int
  customer        User                      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  originalName    String
  mimeType        String
  sizeBytes       Int
  content         Bytes                     @db.ByteA
  status          LicenceVerificationStatus @default(UNDER_REVIEW)
  rejectionReason String?                   @db.Text
  submittedAt     DateTime                  @default(now())
  reviewDueAt     DateTime
  reviewedAt      DateTime?
  reviewedById    Int?
  reviewedBy      User?                     @relation("LicenceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([status])
  @@index([reviewDueAt])
  @@index([customerId])
}

model PlatformPeakDate {
  id        Int      @id @default(autoincrement())
  peakDate  DateTime @db.Date
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([peakDate])
  @@index([peakDate])
}

model PlatformDeadlinePolicy {
  id              Int      @id @default(1)
  publishedTiers  Int[]    @default([1, 3, 7])
  mostLenientDays Int      @default(7)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PlatformSettings {
  id                         Int      @id @default(1)
  commissionRate             Decimal  @default(5) @db.Decimal(5, 2)
  defaultPaymentDeadlineDays Int      @default(3)
  creditTierThresholds       Json     @default("{}") @db.JsonB
  exposureLimits             Json     @default("{}") @db.JsonB
  licenceReuploadWindowHours Int      @default(48)
  featureFlags               Json     @default("{\"allowReceiptUpload\":true,\"automaticOverdueHandling\":true}") @db.JsonB
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model FeatureFlag {
  id          Int       @id @default(autoincrement())
  key         String
  environment String
  enabled     Boolean   @default(false)
  operatorId  Int?
  operator    Operator? @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([key, environment, operatorId])
  @@index([environment, key])
  @@index([operatorId, environment, key])
}

model Booking {
  id             Int     @id @default(autoincrement())
  hostBookingRef String?
  bookingCode    String  @unique

  customerId Int
  customer   User @relation(fields: [customerId], references: [id])

  operatorId Int
  operator   Operator @relation(fields: [operatorId], references: [id])

  serviceName String
  serviceType String?

  bookingDate DateTime
  pickupDate  DateTime?
  returnDate  DateTime?
  location    String?

  totalAmount Decimal       @db.Decimal(10, 2)
  status      BookingStatus @default(PENDING)
  creditTier  String?

  paymentDeadline DateTime?

  // ── Public platform (all nullable/defaulted so Phase 1 rows stay valid) ──
  channel BookingChannel @default(WEB)

  listingId Int?
  listing   Listing? @relation(fields: [listingId], references: [id])

  pickupPointId Int?
  pickupPoint   PickupPoint? @relation("BookingPickupPoint", fields: [pickupPointId], references: [id])

  dropoffPointId Int?
  dropoffPoint   PickupPoint? @relation("BookingDropoffPoint", fields: [dropoffPointId], references: [id])

  // A location the customer asked for that is not on the operator's list.
  // The operator prices it through suggest alternative (FR-LIST-004).
  requestedLocation String?

  quantity Int @default(1)

  // Server-computed. totalAmount stays the amount owed:
  // rentalAmount + addonsAmount + feesAmount - discountAmount
  rentalAmount     Decimal?              @db.Decimal(10, 2)
  addonsAmount     Decimal               @default(0) @db.Decimal(10, 2)
  feesAmount       Decimal               @default(0) @db.Decimal(10, 2)
  discountAmount   Decimal               @default(0) @db.Decimal(10, 2)
  discountFundedBy DiscountFundingSource @default(OPERATOR)

  pricingSnapshot Json? // per-day rates, surcharges and fees as quoted
  bookingDetails  Json? // contact, driver and agreement timestamps

  pickedUpAt        DateTime?
  returnedAt        DateTime?
  serviceResolvedAt DateTime?
  noShowRemark      String?

  addons BookingAddon[]

  alternativeServiceName String?
  alternativePrice       Decimal? @db.Decimal(10, 2)

  alternativePickupDate  DateTime?
  alternativeReturnDate  DateTime?
  alternativeReason      String?
  alternativeSuggestedAt DateTime?
  alternativeUsed        Boolean   @default(false)

  payment                 Payment?
  refunds                 Refund[]
  commissionLedgerEntries CommissionLedgerEntry[]
  paymentScheduleEntries  PaymentScheduleEntry[]
  statusHistory           BookingStatusHistory[]
  receipt                 Receipt?
  invoice                 Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingCode])
  @@index([customerId])
  @@index([operatorId])
  @@index([status])
  @@index([createdAt, status])
  @@index([paymentDeadline])
  @@index([listingId, status])
  @@index([pickupDate, returnDate])
  @@index([dropoffPointId])
}

model BookingStatusHistory {
  id        Int            @id @default(autoincrement())
  bookingId Int
  booking   Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actorId   Int?
  actor     User?          @relation("BookingStatusActor", fields: [actorId], references: [id], onDelete: SetNull)
  oldStatus BookingStatus?
  newStatus BookingStatus
  remark    String
  createdAt DateTime       @default(now())

  @@index([bookingId, createdAt])
  @@index([actorId, createdAt])
}

model Payment {
  id Int @id @default(autoincrement())

  bookingId Int     @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod @default(PENDING)
  status        PaymentStatus @default(UNPAID)
  paidAt        DateTime?
  transactionId String?

  downPaymentAmount         Decimal       @default(0) @db.Decimal(10, 2)
  finalPaymentAmount        Decimal       @default(0) @db.Decimal(10, 2)
  downPaymentDueDate        DateTime?
  finalPaymentDueDate       DateTime?
  downPaymentStatus         PaymentStatus @default(UNPAID)
  finalPaymentStatus        PaymentStatus @default(UNPAID)
  downPaymentPaidAt         DateTime?
  finalPaymentPaidAt        DateTime?
  downPaymentTransactionId  String?
  finalPaymentTransactionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refunds                 Refund[]
  commissionLedgerEntries CommissionLedgerEntry[]

  @@index([status])
  @@index([method])
}

model Refund {
  id Int @id @default(autoincrement())

  bookingId Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  paymentId Int
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  // Usually DOWN_PAYMENT for BNPLB-85 partial refund.
  paymentPart String @default("DOWN_PAYMENT")

  // Original amount paid by the customer.
  paidAmount Decimal @db.Decimal(10, 2)

  // Percentage selected in Operator Settings.
  refundPercent Int?

  // Actual amount returned to customer.
  amount Decimal @db.Decimal(10, 2)

  method PaymentMethod

  status RefundStatus @default(PENDING)

  reason String @db.Text

  // Stripe PaymentIntent ID or manual-payment transaction reference.
  originalTransactionId String?

  // Stripe refund ID such as re_xxx.
  // Manual refunds can leave this empty.
  providerRefundId String? @unique

  // Used when Stripe/manual processing fails.
  lastError String? @db.Text

  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId, status])
  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
}

model CommissionLedgerEntry {
  id Int @id @default(autoincrement())

  bookingId Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  paymentId Int
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  transactionId           String                @unique
  paymentType             String
  grossAmountSen          Int
  netAmountSen            Int
  discountAmountSen       Int
  feeRateBps              Int
  fundedBy                DiscountFundingSource
  feeAmountSen            Int
  stripeFeeAmountSen      Int                   @default(0)
  operatorPayoutAmountSen Int
  platformMarginSen       Int
  payoutId                Int?                  @unique
  payout                  OperatorPayout?       @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  currency                String                @default("MYR")
  createdAt               DateTime              @default(now())

  @@index([bookingId, createdAt])
  @@index([paymentId])
  @@index([createdAt])
}

model PaymentScheduleEntry {
  id          Int                        @id @default(autoincrement())
  bookingId   Int
  booking     Booking                    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type        PaymentScheduleEntryType
  paymentPart String?
  amount      Decimal                    @default(0) @db.Decimal(10, 2)
  dueAt       DateTime
  status      PaymentScheduleEntryStatus @default(DUE)
  paidAt      DateTime?
  voidedAt    DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@index([bookingId, status, dueAt])
  @@index([type, status, dueAt])
}

model OperatorPayout {
  id Int @id @default(autoincrement())

  operatorId Int
  operator   Operator @relation(fields: [operatorId], references: [id])

  destinationAccountId String
  amountSen            Int
  status               OperatorPayoutStatus @default(PENDING)
  idempotencyKey       String               @unique
  stripeTransferId     String?              @unique
  lastError            String?              @db.Text
  createdAt            DateTime             @default(now())
  transferredAt        DateTime?

  ledgerEntry CommissionLedgerEntry?

  @@index([operatorId, status, createdAt])
  @@index([transferredAt])
}

model Receipt {
  id Int @id @default(autoincrement())

  bookingId Int     @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  imageUrl String
  status   ReceiptStatus @default(PENDING)
  remarks  String?

  uploadedAt DateTime  @default(now())
  verifiedAt DateTime?

  @@index([status])
}

model Invoice {
  id Int @id @default(autoincrement())

  bookingId Int     @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  invoiceNo String        @unique
  amount    Decimal       @db.Decimal(10, 2)
  status    InvoiceStatus @default(GENERATED)
  pdfUrl    String?

  issuedAt DateTime  @default(now())
  sentAt   DateTime?

  @@index([invoiceNo])
  @@index([status])
}

model Notification {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  title   String
  message String
  type    String
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model BNPLConfig {
  id Int @id @default(autoincrement())

  operatorId Int
  operator   Operator @relation(fields: [operatorId], references: [id])

  paymentDeadlineDays Int @default(3)

  // Public platform: deposit and missed-balance refund rule
  downPaymentPercent   Int     @default(30)
  partialRefundElected Boolean @default(false)
  partialRefundPercent Int?
  allowReceiptUpload   Boolean @default(true)
  autoCancelOverdue    Boolean @default(true)
  noShowWindowHours    Int     @default(24)

  // Operator booking action settings
  bookingResponseDeadlineMinutes  Int     @default(120)
  autoRejectInactiveBooking       Boolean @default(true)
  reminderBeforeAutoRejectMinutes Int     @default(30)

  // Overtime (SRS 4.3.5): a flat charge for each pickup or return between
  // 21:00 and 09:00, or block night handovers entirely. Set per operator in
  // shop settings; replaces Listing.overtimeFee / blockNightHandover.
  overtimeFee        Decimal? @db.Decimal(10, 2)
  blockNightHandover Boolean  @default(false)

  // Driver rules (BNPLB-85)
  // Minimum allowed driver age. Operator cannot set below 17.
  minDriverAge Int @default(21)

  // Optional young-driver surcharge.
  // Example: min age 21, max age 24 → ages 21–24 pay surcharge.
  youngDriverSurchargeEnabled Boolean  @default(false)
  youngDriverMaxAge           Int      @default(24)
  youngDriverSurcharge        Decimal? @db.Decimal(10, 2)

  // Payment settings
  acceptedPaymentMethods Json?
  manualPaymentNote      String?

  // Notification settings
  operatorReminderBeforeAutoRejectMinutes Int     @default(30)
  enableOperatorReminderAlerts            Boolean @default(true)

  // Email branding
  invoiceLogoUrl    String?
  invoiceFooterText String?

  // Rejection email custom text
  bookingRejectedEmailText String?
  autoRejectedEmailText    String?

  // Customer email custom text (operator-configurable)
  bookingCancelledEmailText     String?
  bookingCompletedEmailText     String?
  paymentRequestEmailText       String?
  alternativeSuggestedEmailText String?

  // Per-company footer shown on customer emails
  emailFooterText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId])
}

model AuditLog {
  id Int @id @default(autoincrement())

  userId    Int?
  user      User?   @relation(fields: [userId], references: [id])
  actorId   Int?
  actorType String?
  requestId String?

  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  details    Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([requestId])
  @@index([action, createdAt])
}

model EmailLog {
  id Int @id @default(autoincrement())

  toEmail String
  subject String
  type    String
  status  EmailStatus @default(PENDING)

  relatedEntityType String?
  relatedEntityId   String?

  userId Int?
  error  String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?
  updatedAt DateTime  @updatedAt

  @@index([toEmail])
  @@index([type])
  @@index([status])
  @@index([relatedEntityType])
  @@index([relatedEntityId])
  @@index([userId])
}

model HostBookingIntent {
  id Int @id @default(autoincrement())

  token          String @unique
  operatorId     Int
  operatorCode   String
  hostBookingRef String
  customerName   String
  customerEmail  String

  serviceName String
  serviceType String?
  bookingDate DateTime
  pickupDate  DateTime?
  returnDate  DateTime?
  location    String?
  totalAmount Decimal   @db.Decimal(10, 2)

  payload Json?

  status           String   @default("PENDING")
  claimedByUserId  Int?
  claimedBookingId Int?
  expiresAt        DateTime

  handoffTokenHash String?   @unique // single-use token handed to the browser
  handoffExpiresAt DateTime? // ~3 min TTL
  handoffUsedAt    DateTime? // burned on first exchange

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([token])
  @@index([hostBookingRef])
  @@index([customerEmail])
  @@index([status])
  @@index([expiresAt])
}

model Branch {
  id Int @id @default(autoincrement())

  operatorId Int
  operator   Operator @relation(fields: [operatorId], references: [id])

  name    String
  address String

  city    String?
  state   String?
  country String  @default("Malaysia")

  phone String?

  // Counter hours, "HH:mm" in operator local time
  openTime  String?
  closeTime String?

  // Per-day hours, Monday first: [{ closed, open, close }] x 7. When null,
  // openTime/closeTime apply every day.
  weeklyHours Json?

  isActive Boolean @default(true)

  listings     Listing[]
  pickupPoints PickupPoint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId])
  @@index([isActive])
}

model Listing {
  id Int @id @default(autoincrement())

  operatorId Int
  operator   Operator @relation(fields: [operatorId], references: [id])

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  category ListingCategory
  status   ListingStatus   @default(DRAFT)

  name        String
  description String? @db.Text

  price    Decimal @db.Decimal(10, 2) // daily rate (FR-LIST-002)
  quantity Int     @default(1)

  // FR-LIST-002 (SRS V2.9): duration-based rates. Weekly covers 7 days and
  // monthly 30 days; an empty weekly or monthly rate falls back to the next
  // shorter rate.
  hourlyRate  Decimal? @db.Decimal(10, 2)
  weeklyRate  Decimal? @db.Decimal(10, 2)
  monthlyRate Decimal? @db.Decimal(10, 2)

  // Flat charge for a pickup or return between 21:00 and 09:00, unless the
  // operator blocks night pickups and returns instead.
  // Retired: overtime is set per operator on BNPLConfig. Nothing reads these;
  // they are dropped in the Module 5 migration.
  overtimeFee        Decimal? @db.Decimal(10, 2)
  blockNightHandover Boolean  @default(false)

  // Collision Damage Waiver: default add-on, priced per day per listing,
  // optional for the customer. Null means the operator has not priced it yet.
  cdwDailyPrice Decimal? @db.Decimal(10, 2)

  // Retired by SRS V2.9. Kept until the operator form stops writing them.
  weekendPrice Decimal? @db.Decimal(10, 2)
  peakPrice    Decimal? @db.Decimal(10, 2)

  // Car rental fields
  vehicleMake  String?
  vehicleModel String?

  modelYear Int?
  seats     Int?

  transmission TransmissionType?

  luggageCapacity Int?

  vehicleType   VehicleType?
  powertrain    Powertrain?
  drivetrain    Drivetrain?
  fuelPolicy    FuelPolicy?
  mileagePolicy MileagePolicy @default(UNLIMITED)

  mileageLimitKm    Int?
  mileageExcessRate Decimal? @db.Decimal(10, 2)

  minDriverAge         Int      @default(21)
  youngDriverMaxAge    Int?
  youngDriverSurcharge Decimal? @db.Decimal(10, 2) // per day

  travelArea String? @db.Text

  pickupRules   String? @db.Text
  returnRules   String? @db.Text
  insuranceInfo String? @db.Text

  // Tour fields
  durationDays Int?

  highlights Json?
  itinerary  Json?
  inclusions Json?
  exclusions Json?

  cancellationPolicy String? @db.Text
  meetingPoint       String?
  maxGroupSize       Int?

  // Common policies
  refundPolicy       String? @db.Text
  termsAndConditions String? @db.Text

  images      ListingImage[]
  addons      ListingAddon[]
  allocations ListingAllocation[]
  bookings    Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId])
  @@index([branchId])
  @@index([category])
  @@index([status])
  @@index([vehicleMake])
  @@index([vehicleModel])
  @@index([transmission])
  @@index([vehicleType])
}

model ListingImage {
  id Int @id @default(autoincrement())

  listingId Int
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  imageUrl   String
  storageKey String?

  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
  @@index([sortOrder])
  @@index([isPrimary])
}

model CronJobRun {
  id Int @id @default(autoincrement())

  jobType String
  status  String @default("SUCCESS")

  triggeredByUserId Int?
  triggerSource     String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  affectedCount Int     @default(0)
  result        Json?
  error         String?

  createdAt DateTime @default(now())

  @@index([jobType])
  @@index([status])
  @@index([startedAt])
  @@index([triggeredByUserId])
}

model CronJobLog {
  id             Int       @id @default(autoincrement())
  jobName        String    @map("job_name")
  startedAt      DateTime  @default(now()) @map("started_at")
  endedAt        DateTime? @map("ended_at")
  processedCount Int       @default(0) @map("processed_count")
  failureCount   Int       @default(0) @map("failure_count")
  errors         Json      @default("[]") @db.JsonB
  status         String    @default("RUNNING")

  @@index([jobName, startedAt])
  @@map("cron_job_logs")
}

// =============================================================================
// Public platform: pricing extras, pickup points, availability, idempotency
// =============================================================================

model ListingAddon {
  id Int @id @default(autoincrement())

  listingId Int
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  name        String
  description String?
  price       Decimal   @db.Decimal(10, 2)
  unit        AddonUnit @default(PER_DAY)
  maxQuantity Int       @default(1)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  bookingAddons BookingAddon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId, isActive])
}

model BookingAddon {
  id Int @id @default(autoincrement())

  bookingId Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // SetNull so an operator can delete an add-on without touching history
  listingAddonId Int?
  listingAddon   ListingAddon? @relation(fields: [listingAddonId], references: [id], onDelete: SetNull)

  // Snapshot at booking time
  name       String
  unit       AddonUnit
  unitPrice  Decimal   @db.Decimal(10, 2)
  quantity   Int
  totalPrice Decimal   @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([bookingId])
}

model PickupPoint {
  id Int @id @default(autoincrement())

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  label      String
  address    String?
  note       String?
  usage      PointUsage @default(BOTH)
  fee        Decimal    @default(0) @db.Decimal(10, 2) // pickup charge
  dropoffFee Decimal    @default(0) @db.Decimal(10, 2)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  bookings        Booking[] @relation("BookingPickupPoint")
  dropoffBookings Booking[] @relation("BookingDropoffPoint")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, isActive])
}

// Operator overrides only. Stock in use is NOT stored here: it is counted
// from active bookings, so every status change anywhere in the codebase frees
// or holds stock without extra hooks. No row = Listing.quantity, not blocked.
model ListingAllocation {
  listingId Int
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  quantity  Int? // overrides Listing.quantity for this day (channel allocation)
  isBlocked Boolean @default(false)
  note      String?

  updatedAt DateTime @updatedAt

  @@id([listingId, date])
  @@index([date])
}

model IdempotencyKey {
  id Int @id @default(autoincrement())

  key      String
  userId   Int
  endpoint String

  requestHash    String
  responseStatus Int?
  responseBody   Json?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@unique([userId, endpoint, key])
  @@index([expiresAt])
}

model StripeWebhookEvent {
  id            String    @id
  type          String
  payload       Json
  requestIp     String?
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  lastError     String?
  receivedAt    DateTime  @default(now())
  nextAttemptAt DateTime  @default(now())
  lockedAt      DateTime?
  processedAt   DateTime?

  @@index([status, nextAttemptAt, receivedAt])
}
