# ─────────────────────────────────────────────────────────────────────────────
# BNPL Backend – Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development                      # development | production

# ── Error monitoring ─────────────────────────────────────────────────────────
# Optional Sentry DSN. Backend exceptions are still written to structured logs when unset.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Per-process early warning; configure a Sentry project-wide metric alert as documented in OBSERVABILITY.md.
ERROR_RATE_WINDOW_MS=300000
ERROR_RATE_THRESHOLD=20
# Optional Slack-compatible incoming webhook for a local spike notification.
ERROR_ALERT_WEBHOOK_URL=

# ── Database (PostgreSQL / Neon) ──────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require

# ── JWT – Access token (1 h) + Refresh token (7 d) ───────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET

# ── Frontend origin (used for CORS and email links) ───────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Frontend origin (used for CORS and email links) ───────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Email ─────────────────────────────────────────────────────────────────────
# Generic SMTP supports recipient addresses on any domain. Use settings from
# your mail provider. Port 465 defaults to TLS; other ports default to STARTTLS.
# For an unauthenticated relay, omit SMTP_USER and SMTP_PASS and set EMAIL_FROM.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# EMAIL_FROM=BNPL System <no-reply@your-domain.com>

# Legacy Gmail fallback (used only when SMTP_HOST is not set)
GMAIL_SMTP_USER=your-gmail-address@gmail.com
GMAIL_SMTP_PASS=xxxx-xxxx-xxxx-xxxx   # Gmail App Password (not your login password)
EMAIL_FROM=BNPL System <your-gmail-address@gmail.com>

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STRIPE_SECRET_KEY
# REQUIRED – obtain from Stripe Dashboard > Webhooks > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STRIPE_WEBHOOK_SECRET
# Optional – Stripe Connect: ID of the connected merchant account to transfer funds to
STRIPE_CONNECTED_ACCOUNT_ID=acct_REPLACE_IF_USING_STRIPE_CONNECT
# Optional – platform fee percentage retained before transferring to merchant (default 5)
STRIPE_PLATFORM_FEE_PERCENT=10

# ── Cron jobs (Vercel Cron / external scheduler) ──────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the same value in your Vercel project environment as CRON_SECRET.
CRON_SECRET=REPLACE_WITH_RANDOM_SECRET

# ── Host API (external booking intake) ───────────────────────────────────────
# LEGACY global host key — kept only as a fallback during Phase 1 migration.
# New hosts use per-operator keys stored on the Operator record. Remove once
# all hosts have switched.
HOST_API_KEY=REPLACE_WITH_RANDOM_API_KEY
