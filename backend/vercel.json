{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/vercel-daily-recovery-sweep",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/vercel-idempotency-cleanup",
      "schedule": "0 * * * *"
    }
  ]
}